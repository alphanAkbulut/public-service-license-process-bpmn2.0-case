<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Defs_P3" targetNamespace="https://github.com/alphanAkbulut/public-service-license-process-bpmn2.0-case" exporter="tools/v2/build.py" exporterVersion="2.0">
  <bpmn:error id="Err_Second" name="Cancelled: after second inspection" errorCode="SECOND_INSPECTION_FAILED" />
  <bpmn:error id="Err_Zoning" name="Cancelled: zoning status" errorCode="ZONING_REJECTED" />
  <bpmn:collaboration id="Collab_P3">
    <bpmn:participant id="Part_P3" name="Municipality" processRef="Process_03_site_inspection" />
  </bpmn:collaboration>
  <bpmn:process id="Process_03_site_inspection" name="Stage 3 — Inspect premises" isExecutable="false">
    <bpmn:laneSet id="LaneSet_P3">
      <bpmn:lane id="P3_Lane_LD" name="Licensing &amp; Inspection Directorate">
        <bpmn:flowNodeRef>P3_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_xZ</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_xI</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_tm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_gP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P3_Lane_INSP" name="Field Inspection Team">
        <bpmn:flowNodeRef>P3_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_xI2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P3_Lane_SYS" name="Automated Notifications">
        <bpmn:flowNodeRef>P3_xM1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_t2s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_xM1m</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_eZ</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_tN</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_xM2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_xM2m</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_eD</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P3_s" name="Technical opinions completed">
      <bpmn:outgoing>P3_Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="P3_t1" name="Start site inspection">
      <bpmn:documentation>Source step O23: Ruhsat ve Denetim Müdürlüğü - Saha Denetimini Başlatma</bpmn:documentation>
      <bpmn:incoming>P3_Flow_0</bpmn:incoming>
      <bpmn:outgoing>P3_Flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P3_xZ" name="Zoning status?">
      <bpmn:incoming>P3_Flow_1</bpmn:incoming>
      <bpmn:outgoing>P3_Flow_2</bpmn:outgoing>
      <bpmn:outgoing>P3_Flow_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="P3_xM1" name="E-mail address registered?">
      <bpmn:incoming>P3_Flow_2</bpmn:incoming>
      <bpmn:outgoing>P3_Flow_4</bpmn:outgoing>
      <bpmn:outgoing>P3_Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="P3_t2s" name="Send zoning-based cancellation notice">
      <bpmn:documentation>Source step O24: İmar Durumuna Göre Başvuru İptal Bilgilendirmesi</bpmn:documentation>
      <bpmn:incoming>P3_Flow_4</bpmn:incoming>
      <bpmn:outgoing>P3_Flow_6</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="P3_xM1m">
      <bpmn:incoming>P3_Flow_5</bpmn:incoming>
      <bpmn:incoming>P3_Flow_6</bpmn:incoming>
      <bpmn:outgoing>P3_Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P3_eZ" name="Cancelled — zoning status">
      <bpmn:incoming>P3_Flow_7</bpmn:incoming>
      <bpmn:errorEventDefinition id="P3_eZ_ed" errorRef="Err_Zoning" />
    </bpmn:endEvent>
    <bpmn:userTask id="P3_t2" name="Carry out site inspection">
      <bpmn:documentation>Source step O25: Ruhsat ve Denetim Müdürlüğü - Saha Denetimi</bpmn:documentation>
      <bpmn:incoming>P3_Flow_3</bpmn:incoming>
      <bpmn:outgoing>P3_Flow_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P3_xI" name="Inspection result?">
      <bpmn:incoming>P3_Flow_8</bpmn:incoming>
      <bpmn:outgoing>P3_Flow_9</bpmn:outgoing>
      <bpmn:outgoing>P3_Flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="P3_tN" name="Send deficiency notice (SMS or e-mail)">
      <bpmn:incoming>P3_Flow_10</bpmn:incoming>
      <bpmn:outgoing>P3_Flow_11</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="P3_tm" name="15 days">
      <bpmn:documentation>Source step T1: Zamanlayıcı 15 Gün</bpmn:documentation>
      <bpmn:incoming>P3_Flow_11</bpmn:incoming>
      <bpmn:outgoing>P3_Flow_12</bpmn:outgoing>
      <bpmn:timerEventDefinition id="P3_tm_td"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P15D</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="P3_t3" name="Start second site inspection">
      <bpmn:documentation>Source step O26: Ruhsat ve Denetim Müdürlüğü - 2. Saha Denetimini Başlatma</bpmn:documentation>
      <bpmn:incoming>P3_Flow_12</bpmn:incoming>
      <bpmn:outgoing>P3_Flow_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P3_t4" name="Carry out second site inspection">
      <bpmn:documentation>Source step O27: Ruhsat ve Denetim Müdürlüğü 2. Saha Denetimi</bpmn:documentation>
      <bpmn:incoming>P3_Flow_13</bpmn:incoming>
      <bpmn:outgoing>P3_Flow_14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P3_xI2" name="Second inspection result?">
      <bpmn:incoming>P3_Flow_14</bpmn:incoming>
      <bpmn:outgoing>P3_Flow_15</bpmn:outgoing>
      <bpmn:outgoing>P3_Flow_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P3_t5" name="Cancel application after second inspection">
      <bpmn:documentation>Source step O28: 2. Denetim Sonrası Başvurunun İptali</bpmn:documentation>
      <bpmn:incoming>P3_Flow_16</bpmn:incoming>
      <bpmn:outgoing>P3_Flow_17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P3_xM2" name="E-mail address registered?">
      <bpmn:incoming>P3_Flow_17</bpmn:incoming>
      <bpmn:outgoing>P3_Flow_18</bpmn:outgoing>
      <bpmn:outgoing>P3_Flow_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="P3_t6" name="Send application cancellation notice">
      <bpmn:documentation>Source step O29: Başvuru İptal Bilgilendirmesi</bpmn:documentation>
      <bpmn:incoming>P3_Flow_18</bpmn:incoming>
      <bpmn:outgoing>P3_Flow_20</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="P3_xM2m">
      <bpmn:incoming>P3_Flow_19</bpmn:incoming>
      <bpmn:incoming>P3_Flow_20</bpmn:incoming>
      <bpmn:outgoing>P3_Flow_21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P3_eD" name="Cancelled — after second inspection">
      <bpmn:incoming>P3_Flow_21</bpmn:incoming>
      <bpmn:errorEventDefinition id="P3_eD_ed" errorRef="Err_Second" />
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="P3_gP">
      <bpmn:incoming>P3_Flow_9</bpmn:incoming>
      <bpmn:incoming>P3_Flow_15</bpmn:incoming>
      <bpmn:outgoing>P3_Flow_22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P3_e" name="Ready for commission review">
      <bpmn:incoming>P3_Flow_22</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P3_Flow_0" sourceRef="P3_s" targetRef="P3_t1" />
    <bpmn:sequenceFlow id="P3_Flow_1" sourceRef="P3_t1" targetRef="P3_xZ" />
    <bpmn:sequenceFlow id="P3_Flow_2" name="Zoning rejected" sourceRef="P3_xZ" targetRef="P3_xM1" />
    <bpmn:sequenceFlow id="P3_Flow_3" name="Zoning approved" sourceRef="P3_xZ" targetRef="P3_t2" />
    <bpmn:sequenceFlow id="P3_Flow_4" name="Yes (label added)" sourceRef="P3_xM1" targetRef="P3_t2s" />
    <bpmn:sequenceFlow id="P3_Flow_5" name="No (label added)" sourceRef="P3_xM1" targetRef="P3_xM1m" />
    <bpmn:sequenceFlow id="P3_Flow_6" sourceRef="P3_t2s" targetRef="P3_xM1m" />
    <bpmn:sequenceFlow id="P3_Flow_7" sourceRef="P3_xM1m" targetRef="P3_eZ" />
    <bpmn:sequenceFlow id="P3_Flow_8" sourceRef="P3_t2" targetRef="P3_xI" />
    <bpmn:sequenceFlow id="P3_Flow_9" name="Passed (label added)" sourceRef="P3_xI" targetRef="P3_gP" />
    <bpmn:sequenceFlow id="P3_Flow_10" name="Correction needed (label added)" sourceRef="P3_xI" targetRef="P3_tN" />
    <bpmn:sequenceFlow id="P3_Flow_11" sourceRef="P3_tN" targetRef="P3_tm" />
    <bpmn:sequenceFlow id="P3_Flow_12" sourceRef="P3_tm" targetRef="P3_t3" />
    <bpmn:sequenceFlow id="P3_Flow_13" sourceRef="P3_t3" targetRef="P3_t4" />
    <bpmn:sequenceFlow id="P3_Flow_14" sourceRef="P3_t4" targetRef="P3_xI2" />
    <bpmn:sequenceFlow id="P3_Flow_15" name="Passed (label added)" sourceRef="P3_xI2" targetRef="P3_gP" />
    <bpmn:sequenceFlow id="P3_Flow_16" name="Failed (label added)" sourceRef="P3_xI2" targetRef="P3_t5" />
    <bpmn:sequenceFlow id="P3_Flow_17" sourceRef="P3_t5" targetRef="P3_xM2" />
    <bpmn:sequenceFlow id="P3_Flow_18" name="Yes (label added)" sourceRef="P3_xM2" targetRef="P3_t6" />
    <bpmn:sequenceFlow id="P3_Flow_19" name="No (label added)" sourceRef="P3_xM2" targetRef="P3_xM2m" />
    <bpmn:sequenceFlow id="P3_Flow_20" sourceRef="P3_t6" targetRef="P3_xM2m" />
    <bpmn:sequenceFlow id="P3_Flow_21" sourceRef="P3_xM2m" targetRef="P3_eD" />
    <bpmn:sequenceFlow id="P3_Flow_22" sourceRef="P3_gP" targetRef="P3_e" />
    <bpmn:textAnnotation id="P3_a1"><bpmn:text>Added on the author&#x27;s confirmation: the system sends the deficiency notice automatically by SMS or e-mail</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="P3_a1_assoc" sourceRef="P3_a1" targetRef="P3_tN" />
    <bpmn:textAnnotation id="P3_a2"><bpmn:text>Art. 13: reach this step within 1 month of the declaration-based license. In practice earlier stages finish in a few days.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="P3_a2_assoc" sourceRef="P3_a2" targetRef="P3_t1" />
  </bpmn:process>
