<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Defs_P5" targetNamespace="https://github.com/alphanAkbulut/public-service-license-process-bpmn2.0-case" exporter="tools/v2/build.py" exporterVersion="2.0">
  <bpmn:error id="Err_Deputy" name="Cancelled: deputy mayor level" errorCode="CANCELLED_DEPUTY" />
  <bpmn:error id="Err_Mayor" name="Cancelled: mayor level" errorCode="CANCELLED_MAYOR" />
  <bpmn:collaboration id="Collab_P5">
    <bpmn:participant id="Part_P5" name="Municipality" processRef="Process_05_executive_approval" />
  </bpmn:collaboration>
  <bpmn:process id="Process_05_executive_approval" name="Stage 5 — Executive approval" isExecutable="false">
    <bpmn:laneSet id="LaneSet_P5">
      <bpmn:lane id="P5_Lane_LD" name="Licensing &amp; Inspection Directorate">
        <bpmn:flowNodeRef>P5_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P5_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P5_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P5_g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P5_t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P5_g6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P5_eB</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P5_Lane_DEP" name="Deputy Mayor">
        <bpmn:flowNodeRef>P5_gM1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P5_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P5_g1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P5_Lane_MAY" name="Mayor">
        <bpmn:flowNodeRef>P5_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P5_g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P5_gM2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P5_t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P5_g5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P5_e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P5_Lane_SYS" name="Automated Notifications">
        <bpmn:flowNodeRef>P5_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P5_g3m</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P5_eA</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P5_s" name="License fee collected">
      <bpmn:outgoing>P5_Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="P5_t1" name="Process license approval">
      <bpmn:documentation>Source step O34: Sıhhi Müessese Ruhsat Başvurusu Onay İşlemi</bpmn:documentation>
      <bpmn:incoming>P5_Flow_0</bpmn:incoming>
      <bpmn:outgoing>P5_Flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P5_gM1">
      <bpmn:incoming>P5_Flow_1</bpmn:incoming>
      <bpmn:incoming>P5_Flow_8</bpmn:incoming>
      <bpmn:outgoing>P5_Flow_2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P5_t2" name="Approve license">
      <bpmn:documentation>Source step O35: Başkan Yardımcısı - Sıhhi Müessese Ruhsat Onayı</bpmn:documentation>
      <bpmn:incoming>P5_Flow_2</bpmn:incoming>
      <bpmn:outgoing>P5_Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P5_g1" name="Deputy mayor decision?">
      <bpmn:incoming>P5_Flow_3</bpmn:incoming>
      <bpmn:outgoing>P5_Flow_4</bpmn:outgoing>
      <bpmn:outgoing>P5_Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P5_t3" name="Inform about cancellation of the application">
      <bpmn:documentation>Source step O36: Sıhhi Müessese Ruhsat Başvurusu&#x27;nun İptalinin Bilgilendirmesi</bpmn:documentation>
      <bpmn:incoming>P5_Flow_4</bpmn:incoming>
      <bpmn:outgoing>P5_Flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P5_g2" name="Cancel or resubmit?">
      <bpmn:incoming>P5_Flow_6</bpmn:incoming>
      <bpmn:outgoing>P5_Flow_7</bpmn:outgoing>
      <bpmn:outgoing>P5_Flow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P5_t4" name="Process cancellation notification">
      <bpmn:documentation>Source step O37: Sıhhi Müessese Ruhsat Başvurusu&#x27;nun İptali İçin Bilgilendirme İşlemi</bpmn:documentation>
      <bpmn:incoming>P5_Flow_7</bpmn:incoming>
      <bpmn:outgoing>P5_Flow_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P5_g3" name="E-mail address registered?">
      <bpmn:incoming>P5_Flow_9</bpmn:incoming>
      <bpmn:outgoing>P5_Flow_10</bpmn:outgoing>
      <bpmn:outgoing>P5_Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="P5_t5" name="Send cancellation e-mail">
      <bpmn:documentation>Source step O38: [kurum içi e-posta servisi] Mail Task</bpmn:documentation>
      <bpmn:incoming>P5_Flow_10</bpmn:incoming>
      <bpmn:outgoing>P5_Flow_12</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="P5_g3m">
      <bpmn:incoming>P5_Flow_11</bpmn:incoming>
      <bpmn:incoming>P5_Flow_12</bpmn:incoming>
      <bpmn:outgoing>P5_Flow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P5_eA" name="Cancelled — deputy mayor level">
      <bpmn:incoming>P5_Flow_13</bpmn:incoming>
      <bpmn:errorEventDefinition id="P5_eA_ed" errorRef="Err_Deputy" />
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="P5_gM2">
      <bpmn:incoming>P5_Flow_5</bpmn:incoming>
      <bpmn:incoming>P5_Flow_20</bpmn:incoming>
      <bpmn:outgoing>P5_Flow_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P5_t6" name="Approve license">
      <bpmn:documentation>Source step O39: Sıhhi Müessese Ruhsat Başvurusu Onayı</bpmn:documentation>
      <bpmn:incoming>P5_Flow_14</bpmn:incoming>
      <bpmn:outgoing>P5_Flow_15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P5_g5" name="Mayor decision?">
      <bpmn:incoming>P5_Flow_15</bpmn:incoming>
      <bpmn:outgoing>P5_Flow_16</bpmn:outgoing>
      <bpmn:outgoing>P5_Flow_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P5_e" name="License approved">
      <bpmn:incoming>P5_Flow_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="P5_t7" name="Inform about application cancellation">
      <bpmn:documentation>Source step O40: Sıhhi Müessese Ruhsat Başvurusu İptal Bilgilendirmesi</bpmn:documentation>
      <bpmn:incoming>P5_Flow_17</bpmn:incoming>
      <bpmn:outgoing>P5_Flow_18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P5_g6" name="Cancel or resubmit?">
      <bpmn:incoming>P5_Flow_18</bpmn:incoming>
      <bpmn:outgoing>P5_Flow_19</bpmn:outgoing>
      <bpmn:outgoing>P5_Flow_20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P5_eB" name="Cancelled — mayor level">
      <bpmn:incoming>P5_Flow_19</bpmn:incoming>
      <bpmn:errorEventDefinition id="P5_eB_ed" errorRef="Err_Mayor" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P5_Flow_0" sourceRef="P5_s" targetRef="P5_t1" />
    <bpmn:sequenceFlow id="P5_Flow_1" sourceRef="P5_t1" targetRef="P5_gM1" />
    <bpmn:sequenceFlow id="P5_Flow_2" sourceRef="P5_gM1" targetRef="P5_t2" />
    <bpmn:sequenceFlow id="P5_Flow_3" sourceRef="P5_t2" targetRef="P5_g1" />
    <bpmn:sequenceFlow id="P5_Flow_4" name="Cancel" sourceRef="P5_g1" targetRef="P5_t3" />
    <bpmn:sequenceFlow id="P5_Flow_5" name="Approve" sourceRef="P5_g1" targetRef="P5_gM2" />
    <bpmn:sequenceFlow id="P5_Flow_6" sourceRef="P5_t3" targetRef="P5_g2" />
    <bpmn:sequenceFlow id="P5_Flow_7" name="Cancel application" sourceRef="P5_g2" targetRef="P5_t4" />
    <bpmn:sequenceFlow id="P5_Flow_8" name="Resubmit (label added)" sourceRef="P5_g2" targetRef="P5_gM1" />
    <bpmn:sequenceFlow id="P5_Flow_9" sourceRef="P5_t4" targetRef="P5_g3" />
    <bpmn:sequenceFlow id="P5_Flow_10" name="Yes (label added)" sourceRef="P5_g3" targetRef="P5_t5" />
    <bpmn:sequenceFlow id="P5_Flow_11" name="No (label added)" sourceRef="P5_g3" targetRef="P5_g3m" />
    <bpmn:sequenceFlow id="P5_Flow_12" sourceRef="P5_t5" targetRef="P5_g3m" />
    <bpmn:sequenceFlow id="P5_Flow_13" sourceRef="P5_g3m" targetRef="P5_eA" />
    <bpmn:sequenceFlow id="P5_Flow_14" sourceRef="P5_gM2" targetRef="P5_t6" />
    <bpmn:sequenceFlow id="P5_Flow_15" sourceRef="P5_t6" targetRef="P5_g5" />
    <bpmn:sequenceFlow id="P5_Flow_16" name="Approve" sourceRef="P5_g5" targetRef="P5_e" />
    <bpmn:sequenceFlow id="P5_Flow_17" name="Cancel" sourceRef="P5_g5" targetRef="P5_t7" />
    <bpmn:sequenceFlow id="P5_Flow_18" sourceRef="P5_t7" targetRef="P5_g6" />
    <bpmn:sequenceFlow id="P5_Flow_19" name="Cancel application" sourceRef="P5_g6" targetRef="P5_eB" />
    <bpmn:sequenceFlow id="P5_Flow_20" name="Resubmit for approval" sourceRef="P5_g6" targetRef="P5_gM2" />
    <bpmn:textAnnotation id="P5_a1"><bpmn:text>Two-level approval is internal practice. Art. 6: the license is signed by the head of the authority or a delegate.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="P5_a1_assoc" sourceRef="P5_a1" targetRef="P5_t2" />
  </bpmn:process>
