<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Defs_P1" targetNamespace="https://github.com/alphanAkbulut/public-service-license-process-bpmn2.0-case" exporter="tools/v2/build.py" exporterVersion="2.0">
  <bpmn:escalation id="Esc_Accrual" name="Debt due: transfer to collection (accrual)" escalationCode="DEBT_DUE_ACCRUAL" />
  <bpmn:escalation id="Esc_Payment" name="Debt due: transfer to collection (payment)" escalationCode="DEBT_DUE_PAYMENT" />
  <bpmn:collaboration id="Collab_P1">
    <bpmn:participant id="Part_P1" name="Municipality" processRef="Process_01_register_and_survey" />
  </bpmn:collaboration>
  <bpmn:process id="Process_01_register_and_survey" name="Stage 1 — Register application and survey site" isExecutable="false">
    <bpmn:laneSet id="LaneSet_P1">
      <bpmn:lane id="P1_Lane_LD" name="Licensing &amp; Inspection Directorate">
        <bpmn:flowNodeRef>P1_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_e1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P1_Lane_REC" name="Records Office">
        <bpmn:flowNodeRef>P1_t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_gJ</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P1_Lane_RE" name="Real Estate Unit">
        <bpmn:flowNodeRef>P1_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_gA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_gB</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_gC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_gCm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_gP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_b5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_gM</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P1_Lane_SYS" name="Automated Notifications">
        <bpmn:flowNodeRef>P1_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_e5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P1_Lane_CASH" name="Cashier">
        <bpmn:flowNodeRef>P1_t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_b6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_e6b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_e6</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P1_s" name="Application received (business may already be operating)">
      <bpmn:outgoing>P1_Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="P1_t1" name="Register documents, check debts, take declaration form">
      <bpmn:documentation>Source step O1: Ruhsat Müdürlüğü - Sıhhi Müessese Ruhsat Başvurusu İçin Evrak Kayıt, Kontrol ve Borç Bilgisi Sorgulama, Başvuru Beyan Formu Alma</bpmn:documentation>
      <bpmn:incoming>P1_Flow_0</bpmn:incoming>
      <bpmn:outgoing>P1_Flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P1_t2" name="Start site survey and accrual">
      <bpmn:documentation>Source step O2: Taşınmaz Birimi - Saha Denetimi Başlatma, Tahakkuk</bpmn:documentation>
      <bpmn:incoming>P1_Flow_1</bpmn:incoming>
      <bpmn:outgoing>P1_Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="P1_g1">
      <bpmn:incoming>P1_Flow_2</bpmn:incoming>
      <bpmn:outgoing>P1_Flow_3</bpmn:outgoing>
      <bpmn:outgoing>P1_Flow_4</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="P1_gA" name="Accrual already done?">
      <bpmn:incoming>P1_Flow_3</bpmn:incoming>
      <bpmn:outgoing>P1_Flow_5</bpmn:outgoing>
      <bpmn:outgoing>P1_Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P1_t3" name="Approve site survey">
      <bpmn:documentation>Source step O3: Taşınmaz Birimi - Saha Tespiti Onay</bpmn:documentation>
      <bpmn:incoming>P1_Flow_5</bpmn:incoming>
      <bpmn:outgoing>P1_Flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P1_gB" name="Business active?">
      <bpmn:incoming>P1_Flow_7</bpmn:incoming>
      <bpmn:outgoing>P1_Flow_8</bpmn:outgoing>
      <bpmn:outgoing>P1_Flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="P1_gC" name="E-mail address registered?">
      <bpmn:incoming>P1_Flow_8</bpmn:incoming>
      <bpmn:outgoing>P1_Flow_10</bpmn:outgoing>
      <bpmn:outgoing>P1_Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="P1_t4" name="Send application info e-mail and accrual invitation">
      <bpmn:documentation>Source step O4: Başvuru Bilgi E-Postası, Tahakkuk Daveti</bpmn:documentation>
      <bpmn:incoming>P1_Flow_10</bpmn:incoming>
      <bpmn:outgoing>P1_Flow_12</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="P1_gCm">
      <bpmn:incoming>P1_Flow_11</bpmn:incoming>
      <bpmn:incoming>P1_Flow_12</bpmn:incoming>
      <bpmn:outgoing>P1_Flow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="P1_gP">
      <bpmn:incoming>P1_Flow_13</bpmn:incoming>
      <bpmn:outgoing>P1_Flow_14</bpmn:outgoing>
      <bpmn:outgoing>P1_Flow_15</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="P1_t5" name="Record tax accrual">
      <bpmn:documentation>Source step O5: Taşınmaz Birimi - Tahakkuk Adımı</bpmn:documentation>
      <bpmn:incoming>P1_Flow_14</bpmn:incoming>
      <bpmn:outgoing>P1_Flow_16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="P1_b5" name="Debt due: transfer to collection" attachedToRef="P1_t5" cancelActivity="false">
      <bpmn:outgoing>P1_Flow_17</bpmn:outgoing>
      <bpmn:escalationEventDefinition id="P1_b5_esd" escalationRef="Esc_Accrual" />
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="P1_e5" name="Transferred to collection">
      <bpmn:incoming>P1_Flow_17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="P1_t6" name="Collect payment (municipal payment system)">
      <bpmn:documentation>Source step O6: [kurum içi proje adı] - Tahsilat</bpmn:documentation>
      <bpmn:incoming>P1_Flow_16</bpmn:incoming>
      <bpmn:outgoing>P1_Flow_18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="P1_b6" name="Debt due: transfer to collection" attachedToRef="P1_t6" cancelActivity="false">
      <bpmn:outgoing>P1_Flow_19</bpmn:outgoing>
      <bpmn:escalationEventDefinition id="P1_b6_esd" escalationRef="Esc_Payment" />
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="P1_e6b" name="Transferred to collection">
      <bpmn:incoming>P1_Flow_19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="P1_e6" name="Payment collected">
      <bpmn:incoming>P1_Flow_18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="P1_gM">
      <bpmn:incoming>P1_Flow_6</bpmn:incoming>
      <bpmn:incoming>P1_Flow_9</bpmn:incoming>
      <bpmn:incoming>P1_Flow_15</bpmn:incoming>
      <bpmn:outgoing>P1_Flow_20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P1_t7" name="Receive license application">
      <bpmn:documentation>Source step O7: Yazı İşleri - Sıhhi Müessese Ruhsat Başvurusu Alma</bpmn:documentation>
      <bpmn:incoming>P1_Flow_4</bpmn:incoming>
      <bpmn:outgoing>P1_Flow_21</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="P1_gJ">
      <bpmn:incoming>P1_Flow_20</bpmn:incoming>
      <bpmn:incoming>P1_Flow_21</bpmn:incoming>
      <bpmn:outgoing>P1_Flow_22</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="P1_t8" name="Review site survey and front-office work">
      <bpmn:documentation>Source step O8: Ruhsat Müdürlüğü - Taşınmaz Birimi Saha Tespiti ve Ruhsat Büro Personeli İşlemlerini Kontrolü</bpmn:documentation>
      <bpmn:incoming>P1_Flow_22</bpmn:incoming>
      <bpmn:outgoing>P1_Flow_23</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="P1_e1" name="Application registered">
      <bpmn:incoming>P1_Flow_23</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P1_Flow_0" sourceRef="P1_s" targetRef="P1_t1" />
    <bpmn:sequenceFlow id="P1_Flow_1" sourceRef="P1_t1" targetRef="P1_t2" />
    <bpmn:sequenceFlow id="P1_Flow_2" sourceRef="P1_t2" targetRef="P1_g1" />
    <bpmn:sequenceFlow id="P1_Flow_3" sourceRef="P1_g1" targetRef="P1_gA" />
    <bpmn:sequenceFlow id="P1_Flow_4" sourceRef="P1_g1" targetRef="P1_t7" />
    <bpmn:sequenceFlow id="P1_Flow_5" name="No (label added)" sourceRef="P1_gA" targetRef="P1_t3" />
    <bpmn:sequenceFlow id="P1_Flow_6" name="Accrual done" sourceRef="P1_gA" targetRef="P1_gM" />
    <bpmn:sequenceFlow id="P1_Flow_7" sourceRef="P1_t3" targetRef="P1_gB" />
    <bpmn:sequenceFlow id="P1_Flow_8" name="Active (label added)" sourceRef="P1_gB" targetRef="P1_gC" />
    <bpmn:sequenceFlow id="P1_Flow_9" name="Business not active" sourceRef="P1_gB" targetRef="P1_gM" />
    <bpmn:sequenceFlow id="P1_Flow_10" name="E-mail registered" sourceRef="P1_gC" targetRef="P1_t4" />
    <bpmn:sequenceFlow id="P1_Flow_11" name="No (label added)" sourceRef="P1_gC" targetRef="P1_gCm" />
    <bpmn:sequenceFlow id="P1_Flow_12" sourceRef="P1_t4" targetRef="P1_gCm" />
    <bpmn:sequenceFlow id="P1_Flow_13" sourceRef="P1_gCm" targetRef="P1_gP" />
    <bpmn:sequenceFlow id="P1_Flow_14" sourceRef="P1_gP" targetRef="P1_t5" />
    <bpmn:sequenceFlow id="P1_Flow_15" sourceRef="P1_gP" targetRef="P1_gM" />
    <bpmn:sequenceFlow id="P1_Flow_16" sourceRef="P1_t5" targetRef="P1_t6" />
    <bpmn:sequenceFlow id="P1_Flow_17" sourceRef="P1_b5" targetRef="P1_e5" />
    <bpmn:sequenceFlow id="P1_Flow_18" sourceRef="P1_t6" targetRef="P1_e6" />
    <bpmn:sequenceFlow id="P1_Flow_19" sourceRef="P1_b6" targetRef="P1_e6b" />
    <bpmn:sequenceFlow id="P1_Flow_20" sourceRef="P1_gM" targetRef="P1_gJ" />
    <bpmn:sequenceFlow id="P1_Flow_21" sourceRef="P1_t7" targetRef="P1_gJ" />
    <bpmn:sequenceFlow id="P1_Flow_22" sourceRef="P1_gJ" targetRef="P1_t8" />
    <bpmn:sequenceFlow id="P1_Flow_23" sourceRef="P1_t8" targetRef="P1_e1" />
    <bpmn:textAnnotation id="P1_a1"><bpmn:text>Gateway question and &#x27;No&#x27; label added; source only labels the &#x27;Accrual done&#x27; path</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="P1_a1_assoc" sourceRef="P1_a1" targetRef="P1_gA" />
    <bpmn:textAnnotation id="P1_a2"><bpmn:text>Escalation markers read as &#x27;debt due: transfer to collection&#x27;, based on the source note on accrual staff collecting debts that fall due</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="P1_a2_assoc" sourceRef="P1_a2" targetRef="P1_t5" />
    <bpmn:textAnnotation id="P1_a3"><bpmn:text>As-is: businesses usually opened first and applied afterwards. Art. 6: premises opened without a license are closed.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="P1_a3_assoc" sourceRef="P1_a3" targetRef="P1_s" />
    <bpmn:textAnnotation id="P1_a4"><bpmn:text>Art. 6: a receipt (Örnek 6) is issued on application. Art. 12: if the declaration meets the criteria, a declaration-based license is issued the same day.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="P1_a4_assoc" sourceRef="P1_a4" targetRef="P1_t1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_P1" name="Stage 1 — Register application and survey site">
    <bpmndi:BPMNPlane id="Plane_P1" bpmnElement="Collab_P1">
      <bpmndi:BPMNShape id="Part_P1_di" bpmnElement="Part_P1" isHorizontal="true"><dc:Bounds x="10" y="20" width="2674" height="1040" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P1_Lane_LD_di" bpmnElement="P1_Lane_LD" isHorizontal="true"><dc:Bounds x="40" y="20" width="2644" height="260" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P1_Lane_REC_di" bpmnElement="P1_Lane_REC" isHorizontal="true"><dc:Bounds x="40" y="280" width="2644" height="130" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P1_Lane_RE_di" bpmnElement="P1_Lane_RE" isHorizontal="true"><dc:Bounds x="40" y="410" width="2644" height="260" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P1_Lane_SYS_di" bpmnElement="P1_Lane_SYS" isHorizontal="true"><dc:Bounds x="40" y="670" width="2644" height="130" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P1_Lane_CASH_di" bpmnElement="P1_Lane_CASH" isHorizontal="true"><dc:Bounds x="40" y="800" width="2644" height="260" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P1_s_di" bpmnElement="P1_s"><dc:Bounds x="161" y="197" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="117" y="238" width="124" height="56" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P1_t1_di" bpmnElement="P1_t1"><dc:Bounds x="284" y="175" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P1_t2_di" bpmnElement="P1_t2"><dc:Bounds x="454" y="565" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P1_g1_di" bpmnElement="P1_g1"><dc:Bounds x="664" y="580" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P1_gA_di" bpmnElement="P1_gA" isMarkerVisible="true"><dc:Bounds x="834" y="580" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="879" y="632" width="94" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P1_t3_di" bpmnElement="P1_t3"><dc:Bounds x="964" y="565" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P1_gB_di" bpmnElement="P1_gB" isMarkerVisible="true"><dc:Bounds x="1174" y="580" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1219" y="632" width="100" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P1_gC_di" bpmnElement="P1_gC" isMarkerVisible="true"><dc:Bounds x="1344" y="580" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1389" y="550" width="88" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P1_t4_di" bpmnElement="P1_t4"><dc:Bounds x="1474" y="695" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P1_gCm_di" bpmnElement="P1_gCm" isMarkerVisible="true"><dc:Bounds x="1684" y="580" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P1_gP_di" bpmnElement="P1_gP"><dc:Bounds x="1854" y="580" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P1_t5_di" bpmnElement="P1_t5"><dc:Bounds x="1984" y="565" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P1_b5_di" bpmnElement="P1_b5"><dc:Bounds x="2071" y="627" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P1_e5_di" bpmnElement="P1_e5"><dc:Bounds x="2071" y="717" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="2115" y="721" width="88" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P1_t6_di" bpmnElement="P1_t6"><dc:Bounds x="2154" y="825" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P1_b6_di" bpmnElement="P1_b6"><dc:Bounds x="2241" y="887" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P1_e6b_di" bpmnElement="P1_e6b"><dc:Bounds x="2241" y="977" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="2285" y="981" width="88" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P1_e6_di" bpmnElement="P1_e6"><dc:Bounds x="2371" y="847" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="2336" y="888" width="106" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P1_gM_di" bpmnElement="P1_gM" isMarkerVisible="true"><dc:Bounds x="2024" y="450" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P1_t7_di" bpmnElement="P1_t7"><dc:Bounds x="964" y="305" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P1_gJ_di" bpmnElement="P1_gJ"><dc:Bounds x="2194" y="320" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P1_t8_di" bpmnElement="P1_t8"><dc:Bounds x="2324" y="175" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P1_e1_di" bpmnElement="P1_e1"><dc:Bounds x="2541" y="197" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="2524" y="238" width="70" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P1_a1_di" bpmnElement="P1_a1"><dc:Bounds x="529" y="435" width="200" height="52" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P1_a2_di" bpmnElement="P1_a2"><dc:Bounds x="2119" y="477" width="230" height="66" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P1_a3_di" bpmnElement="P1_a3"><dc:Bounds x="109" y="97" width="215" height="66" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P1_a4_di" bpmnElement="P1_a4"><dc:Bounds x="369" y="97" width="300" height="66" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="P1_Flow_0_di" bpmnElement="P1_Flow_0"><di:waypoint x="197" y="215" /><di:waypoint x="284" y="215" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P1_Flow_1_di" bpmnElement="P1_Flow_1"><di:waypoint x="414" y="215" /><di:waypoint x="434" y="215" /><di:waypoint x="434" y="605" /><di:waypoint x="454" y="605" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P1_Flow_2_di" bpmnElement="P1_Flow_2"><di:waypoint x="584" y="605" /><di:waypoint x="664" y="605" /></bpmndi:BPMNEdge>
