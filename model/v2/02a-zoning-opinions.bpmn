      <bpmn:incoming>P2a_Flow_13</bpmn:incoming>
      <bpmn:outgoing>P2a_Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P2a_tL3" name="Building Inspection Chief — review report">
