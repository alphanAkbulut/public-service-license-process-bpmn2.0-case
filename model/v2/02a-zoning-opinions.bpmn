    </bpmn:startEvent>
    <bpmn:parallelGateway id="P2a_gP">
      <bpmn:incoming>P2a_Flow_0</bpmn:incoming>
      <bpmn:outgoing>P2a_Flow_1</bpmn:outgoing>
      <bpmn:outgoing>P2a_Flow_2</bpmn:outgoing>
    </bpmn:parallelGateway>
