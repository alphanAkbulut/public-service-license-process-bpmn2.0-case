      <bpmn:incoming>P2a_Flow_6</bpmn:incoming>
      <bpmn:outgoing>P2a_Flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P2a_xL1" name="Chief decision?">
      <bpmn:incoming>P2a_Flow_7</bpmn:incoming>
      <bpmn:outgoing>P2a_Flow_8</bpmn:outgoing>
      <bpmn:outgoing>P2a_Flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
