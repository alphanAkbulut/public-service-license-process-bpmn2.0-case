      <bpmndi:BPMNShape id="P4_tK_di" bpmnElement="P4_tK" bioc:stroke="#c8371e" bioc:fill="#fbe9e4"><dc:Bounds x="454" y="305" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P4_eK_di" bpmnElement="P4_eK" bioc:stroke="#c8371e" bioc:fill="#fbe9e4"><dc:Bounds x="671" y="327" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="654" y="368" width="70" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P4_xM_di" bpmnElement="P4_xM" isMarkerVisible="true"><dc:Bounds x="664" y="60" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="709" y="30" width="88" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P4_t2_di" bpmnElement="P4_t2"><dc:Bounds x="794" y="175" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P4_xMm_di" bpmnElement="P4_xMm" isMarkerVisible="true"><dc:Bounds x="1004" y="60" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P4_t3_di" bpmnElement="P4_t3"><dc:Bounds x="1134" y="435" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P4_p1_di" bpmnElement="P4_p1"><dc:Bounds x="1344" y="450" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P4_ee1_di" bpmnElement="P4_ee1"><dc:Bounds x="1351" y="587" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1395" y="591" width="112" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P4_t4_di" bpmnElement="P4_t4"><dc:Bounds x="1474" y="695" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P4_p2_di" bpmnElement="P4_p2"><dc:Bounds x="1684" y="710" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P4_ee2_di" bpmnElement="P4_ee2"><dc:Bounds x="1691" y="847" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1735" y="851" width="112" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P4_e_di" bpmnElement="P4_e"><dc:Bounds x="1861" y="717" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1844" y="758" width="70" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P4_a1_di" bpmnElement="P4_a1"><dc:Bounds x="219" y="155" width="230" height="66" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P4_a2_di" bpmnElement="P4_a2"><dc:Bounds x="1409" y="347" width="230" height="66" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="P4_Flow_0_di" bpmnElement="P4_Flow_0"><di:waypoint x="197" y="85" /><di:waypoint x="284" y="85" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P4_Flow_1_di" bpmnElement="P4_Flow_1" bioc:stroke="#c8371e"><di:waypoint x="414" y="85" /><di:waypoint x="494" y="85" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P4_Flow_2_di" bpmnElement="P4_Flow_2" bioc:stroke="#c8371e"><di:waypoint x="544" y="85" /><di:waypoint x="664" y="85" /><bpmndi:BPMNLabel><dc:Bounds x="550" y="67" width="44" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P4_Flow_3_di" bpmnElement="P4_Flow_3" bioc:stroke="#c8371e"><di:waypoint x="519" y="110" /><di:waypoint x="519" y="305" /><bpmndi:BPMNLabel><dc:Bounds x="525" y="127" width="44" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P4_Flow_4_di" bpmnElement="P4_Flow_4" bioc:stroke="#c8371e"><di:waypoint x="584" y="345" /><di:waypoint x="671" y="345" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P4_Flow_5_di" bpmnElement="P4_Flow_5"><di:waypoint x="689" y="110" /><di:waypoint x="689" y="215" /><di:waypoint x="794" y="215" /><bpmndi:BPMNLabel><dc:Bounds x="695" y="127" width="94" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
