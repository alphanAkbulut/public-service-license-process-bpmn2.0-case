      <bpmndi:BPMNEdge id="P4_a1_assoc_di" bpmnElement="P4_a1_assoc"><di:waypoint x="334" y="155" /><di:waypoint x="340" y="125" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P4_a2_assoc_di" bpmnElement="P4_a2_assoc"><di:waypoint x="1409" y="380" /><di:waypoint x="1380" y="450" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
