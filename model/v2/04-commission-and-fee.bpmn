      <bpmndi:BPMNEdge id="P4_Flow_9_di" bpmnElement="P4_Flow_9"><di:waypoint x="1264" y="475" /><di:waypoint x="1344" y="475" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P4_Flow_10_di" bpmnElement="P4_Flow_10"><di:waypoint x="1369" y="500" /><di:waypoint x="1369" y="587" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P4_Flow_11_di" bpmnElement="P4_Flow_11"><di:waypoint x="1394" y="475" /><di:waypoint x="1539" y="475" /><di:waypoint x="1539" y="695" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P4_Flow_12_di" bpmnElement="P4_Flow_12"><di:waypoint x="1604" y="735" /><di:waypoint x="1684" y="735" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P4_Flow_13_di" bpmnElement="P4_Flow_13"><di:waypoint x="1709" y="760" /><di:waypoint x="1709" y="847" /></bpmndi:BPMNEdge>
