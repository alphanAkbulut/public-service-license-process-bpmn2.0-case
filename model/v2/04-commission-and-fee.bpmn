<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Defs_P4" targetNamespace="https://github.com/alphanAkbulut/public-service-license-process-bpmn2.0-case" exporter="tools/v2/build.py" exporterVersion="2.0">
  <bpmn:error id="Err_Commission" name="Rejected by commission" errorCode="COMMISSION_REJECTED" />
  <bpmn:escalation id="Esc_Accrual" name="Debt due: transfer to collection (accrual)" escalationCode="DEBT_DUE_ACCRUAL" />
  <bpmn:escalation id="Esc_Payment" name="Debt due: transfer to collection (payment)" escalationCode="DEBT_DUE_PAYMENT" />
  <bpmn:collaboration id="Collab_P4">
    <bpmn:participant id="Part_P4" name="Municipality" processRef="Process_04_commission_and_fee" />
  </bpmn:collaboration>
  <bpmn:process id="Process_04_commission_and_fee" name="Stage 4 — Commission review and fee collection" isExecutable="false">
    <bpmn:laneSet id="LaneSet_P4">
      <bpmn:lane id="P4_Lane_LD" name="Licensing &amp; Inspection Directorate">
        <bpmn:flowNodeRef>P4_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P4_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P4_gK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P4_xM</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P4_xMm</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P4_Lane_SYS" name="Automated Notifications">
        <bpmn:flowNodeRef>P4_tK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P4_eK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P4_t2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P4_Lane_ACC" name="Accrual Staff">
        <bpmn:flowNodeRef>P4_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P4_p1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P4_ee1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P4_Lane_CASH" name="Cashier">
        <bpmn:flowNodeRef>P4_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P4_p2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P4_ee2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P4_e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P4_s" name="Ready for commission review">
      <bpmn:outgoing>P4_Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="P4_t1" name="Evaluate in licensing commission">
      <bpmn:documentation>Source step O30: Ruhsat ve Denetim Müdürlüğü - Komisyon Değerlendirme</bpmn:documentation>
      <bpmn:incoming>P4_Flow_0</bpmn:incoming>
      <bpmn:outgoing>P4_Flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P4_gK" name="Commission decision?">
      <bpmn:incoming>P4_Flow_1</bpmn:incoming>
      <bpmn:outgoing>P4_Flow_2</bpmn:outgoing>
      <bpmn:outgoing>P4_Flow_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="P4_tK" name="Send commission rejection notice">
      <bpmn:incoming>P4_Flow_3</bpmn:incoming>
      <bpmn:outgoing>P4_Flow_4</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="P4_eK" name="Rejected by commission">
      <bpmn:incoming>P4_Flow_4</bpmn:incoming>
      <bpmn:errorEventDefinition id="P4_eK_ed" errorRef="Err_Commission" />
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="P4_xM" name="E-mail address registered?">
      <bpmn:incoming>P4_Flow_2</bpmn:incoming>
      <bpmn:outgoing>P4_Flow_5</bpmn:outgoing>
      <bpmn:outgoing>P4_Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="P4_t2" name="Send info e-mail and accrual invitation">
      <bpmn:documentation>Source step O31: Bilgi E-Postası, Tahakkuk Davet</bpmn:documentation>
      <bpmn:incoming>P4_Flow_5</bpmn:incoming>
      <bpmn:outgoing>P4_Flow_7</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="P4_xMm">
      <bpmn:incoming>P4_Flow_6</bpmn:incoming>
      <bpmn:incoming>P4_Flow_7</bpmn:incoming>
      <bpmn:outgoing>P4_Flow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P4_t3" name="Create license fee accrual">
      <bpmn:documentation>Source step O32: Sıhhi Müessese Ruhsat Başvurusu - Tahakkuk Oluşturma İşlemi</bpmn:documentation>
      <bpmn:incoming>P4_Flow_8</bpmn:incoming>
      <bpmn:outgoing>P4_Flow_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="P4_p1">
      <bpmn:incoming>P4_Flow_9</bpmn:incoming>
      <bpmn:outgoing>P4_Flow_10</bpmn:outgoing>
      <bpmn:outgoing>P4_Flow_11</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="P4_ee1" name="Debt due: transfer to collection">
      <bpmn:incoming>P4_Flow_10</bpmn:incoming>
      <bpmn:escalationEventDefinition id="P4_ee1_esd" escalationRef="Esc_Accrual" />
    </bpmn:endEvent>
    <bpmn:userTask id="P4_t4" name="Collect license fee">
      <bpmn:documentation>Source step O33: Sıhhi Müessese Ruhsat Başvurusu Tahsilat İşlemi</bpmn:documentation>
      <bpmn:incoming>P4_Flow_11</bpmn:incoming>
      <bpmn:outgoing>P4_Flow_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="P4_p2">
      <bpmn:incoming>P4_Flow_12</bpmn:incoming>
      <bpmn:outgoing>P4_Flow_13</bpmn:outgoing>
      <bpmn:outgoing>P4_Flow_14</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="P4_ee2" name="Debt due: transfer to collection">
      <bpmn:incoming>P4_Flow_13</bpmn:incoming>
      <bpmn:escalationEventDefinition id="P4_ee2_esd" escalationRef="Esc_Payment" />
    </bpmn:endEvent>
    <bpmn:endEvent id="P4_e" name="License fee collected">
      <bpmn:incoming>P4_Flow_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P4_Flow_0" sourceRef="P4_s" targetRef="P4_t1" />
    <bpmn:sequenceFlow id="P4_Flow_1" sourceRef="P4_t1" targetRef="P4_gK" />
    <bpmn:sequenceFlow id="P4_Flow_2" name="Approved" sourceRef="P4_gK" targetRef="P4_xM" />
    <bpmn:sequenceFlow id="P4_Flow_3" name="Rejected" sourceRef="P4_gK" targetRef="P4_tK" />
    <bpmn:sequenceFlow id="P4_Flow_4" sourceRef="P4_tK" targetRef="P4_eK" />
    <bpmn:sequenceFlow id="P4_Flow_5" name="Yes (label added)" sourceRef="P4_xM" targetRef="P4_t2" />
    <bpmn:sequenceFlow id="P4_Flow_6" name="No e-mail registered" sourceRef="P4_xM" targetRef="P4_xMm" />
    <bpmn:sequenceFlow id="P4_Flow_7" sourceRef="P4_t2" targetRef="P4_xMm" />
    <bpmn:sequenceFlow id="P4_Flow_8" sourceRef="P4_xMm" targetRef="P4_t3" />
    <bpmn:sequenceFlow id="P4_Flow_9" sourceRef="P4_t3" targetRef="P4_p1" />
    <bpmn:sequenceFlow id="P4_Flow_10" sourceRef="P4_p1" targetRef="P4_ee1" />
    <bpmn:sequenceFlow id="P4_Flow_11" sourceRef="P4_p1" targetRef="P4_t4" />
    <bpmn:sequenceFlow id="P4_Flow_12" sourceRef="P4_t4" targetRef="P4_p2" />
    <bpmn:sequenceFlow id="P4_Flow_13" sourceRef="P4_p2" targetRef="P4_ee2" />
    <bpmn:sequenceFlow id="P4_Flow_14" sourceRef="P4_p2" targetRef="P4_e" />
    <bpmn:textAnnotation id="P4_a1"><bpmn:text>Commission is internal practice, not required by the regulation for sıhhi premises. Rejection path added on the author&#x27;s confirmation.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="P4_a1_assoc" sourceRef="P4_a1" targetRef="P4_t1" />
    <bpmn:textAnnotation id="P4_a2"><bpmn:text>Parallel gateways make the source&#x27;s double outgoing arrows explicit. Escalations read as &#x27;debt due: transfer to collection&#x27;.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="P4_a2_assoc" sourceRef="P4_a2" targetRef="P4_p1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_P4" name="Stage 4 — Commission review and fee collection">
    <bpmndi:BPMNPlane id="Plane_P4" bpmnElement="Collab_P4">
      <bpmndi:BPMNShape id="Part_P4_di" bpmnElement="Part_P4" isHorizontal="true"><dc:Bounds x="10" y="20" width="1994" height="910" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P4_Lane_LD_di" bpmnElement="P4_Lane_LD" isHorizontal="true"><dc:Bounds x="40" y="20" width="1964" height="130" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P4_Lane_SYS_di" bpmnElement="P4_Lane_SYS" isHorizontal="true"><dc:Bounds x="40" y="150" width="1964" height="260" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P4_Lane_ACC_di" bpmnElement="P4_Lane_ACC" isHorizontal="true"><dc:Bounds x="40" y="410" width="1964" height="260" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P4_Lane_CASH_di" bpmnElement="P4_Lane_CASH" isHorizontal="true"><dc:Bounds x="40" y="670" width="1964" height="260" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P4_s_di" bpmnElement="P4_s"><dc:Bounds x="161" y="67" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="117" y="108" width="124" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
