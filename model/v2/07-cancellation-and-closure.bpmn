<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Defs_P7" targetNamespace="https://github.com/alphanAkbulut/public-service-license-process-bpmn2.0-case" exporter="tools/v2/build.py" exporterVersion="2.0">
  <bpmn:collaboration id="Collab_P7">
    <bpmn:participant id="Part_P7" name="Municipality" processRef="Process_07_cancellation_and_closure" />
  </bpmn:collaboration>
  <bpmn:process id="Process_07_cancellation_and_closure" name="Stage C — Cancel license and close premises" isExecutable="false">
    <bpmn:laneSet id="LaneSet_P7">
      <bpmn:lane id="P7_Lane_SYS" name="Automated Notifications">
        <bpmn:flowNodeRef>P7_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P7_t1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P7_Lane_ZAB" name="Municipal Police (Zabıta)">
        <bpmn:flowNodeRef>P7_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P7_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P7_e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P7_s" name="License cancelled">
      <bpmn:outgoing>P7_Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="P7_t1" name="Create closure work order for municipal police">
      <bpmn:incoming>P7_Flow_0</bpmn:incoming>
      <bpmn:outgoing>P7_Flow_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:manualTask id="P7_t2" name="Serve closure notice and seal premises (on site)">
      <bpmn:incoming>P7_Flow_1</bpmn:incoming>
      <bpmn:outgoing>P7_Flow_2</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="P7_t3" name="Confirm closure in system">
      <bpmn:incoming>P7_Flow_2</bpmn:incoming>
      <bpmn:outgoing>P7_Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="P7_e" name="Premises closed">
      <bpmn:incoming>P7_Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P7_Flow_0" sourceRef="P7_s" targetRef="P7_t1" />
    <bpmn:sequenceFlow id="P7_Flow_1" sourceRef="P7_t1" targetRef="P7_t2" />
    <bpmn:sequenceFlow id="P7_Flow_2" sourceRef="P7_t2" targetRef="P7_t3" />
    <bpmn:sequenceFlow id="P7_Flow_3" sourceRef="P7_t3" targetRef="P7_e" />
    <bpmn:textAnnotation id="P7_a1"><bpmn:text>Not drawn in the source. Triggered by any of the four cancellation outcomes.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="P7_a1_assoc" sourceRef="P7_a1" targetRef="P7_t1" />
    <bpmn:textAnnotation id="P7_a2"><bpmn:text>The business may challenge the decision in administrative court; that route is out of scope.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="P7_a2_assoc" sourceRef="P7_a2" targetRef="P7_t2" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_P7" name="Stage C — Cancel license and close premises">
    <bpmndi:BPMNPlane id="Plane_P7" bpmnElement="Collab_P7">
      <bpmndi:BPMNShape id="Part_P7_di" bpmnElement="Part_P7" isHorizontal="true"><dc:Bounds x="10" y="20" width="974" height="390" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P7_Lane_SYS_di" bpmnElement="P7_Lane_SYS" isHorizontal="true"><dc:Bounds x="40" y="20" width="944" height="130" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P7_Lane_ZAB_di" bpmnElement="P7_Lane_ZAB" isHorizontal="true"><dc:Bounds x="40" y="150" width="944" height="260" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P7_s_di" bpmnElement="P7_s"><dc:Bounds x="161" y="67" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="126" y="108" width="106" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P7_t1_di" bpmnElement="P7_t1" bioc:stroke="#c8371e" bioc:fill="#fbe9e4"><dc:Bounds x="284" y="45" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P7_t2_di" bpmnElement="P7_t2" bioc:stroke="#c8371e" bioc:fill="#fbe9e4"><dc:Bounds x="454" y="175" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P7_t3_di" bpmnElement="P7_t3" bioc:stroke="#c8371e" bioc:fill="#fbe9e4"><dc:Bounds x="624" y="175" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P7_e_di" bpmnElement="P7_e"><dc:Bounds x="841" y="197" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="812" y="238" width="94" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P7_a1_di" bpmnElement="P7_a1"><dc:Bounds x="429" y="33" width="220" height="52" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P7_a2_di" bpmnElement="P7_a2"><dc:Bounds x="559" y="273" width="250" height="52" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="P7_Flow_0_di" bpmnElement="P7_Flow_0" bioc:stroke="#c8371e"><di:waypoint x="197" y="85" /><di:waypoint x="284" y="85" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P7_Flow_1_di" bpmnElement="P7_Flow_1" bioc:stroke="#c8371e"><di:waypoint x="414" y="85" /><di:waypoint x="434" y="85" /><di:waypoint x="434" y="215" /><di:waypoint x="454" y="215" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P7_Flow_2_di" bpmnElement="P7_Flow_2" bioc:stroke="#c8371e"><di:waypoint x="584" y="215" /><di:waypoint x="624" y="215" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P7_Flow_3_di" bpmnElement="P7_Flow_3" bioc:stroke="#c8371e"><di:waypoint x="754" y="215" /><di:waypoint x="841" y="215" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P7_a1_assoc_di" bpmnElement="P7_a1_assoc"><di:waypoint x="429" y="59" /><di:waypoint x="414" y="64" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P7_a2_assoc_di" bpmnElement="P7_a2_assoc"><di:waypoint x="559" y="299" /><di:waypoint x="538" y="255" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
