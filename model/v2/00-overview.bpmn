<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Defs_P0" targetNamespace="https://github.com/alphanAkbulut/public-service-license-process-bpmn2.0-case" exporter="tools/v2/build.py" exporterVersion="2.0">
  <bpmn:error id="Err_Commission" name="Rejected by commission" errorCode="COMMISSION_REJECTED" />
  <bpmn:error id="Err_Deputy" name="Cancelled: deputy mayor level" errorCode="CANCELLED_DEPUTY" />
  <bpmn:error id="Err_Mayor" name="Cancelled: mayor level" errorCode="CANCELLED_MAYOR" />
  <bpmn:error id="Err_Second" name="Cancelled: after second inspection" errorCode="SECOND_INSPECTION_FAILED" />
  <bpmn:error id="Err_Zoning" name="Cancelled: zoning status" errorCode="ZONING_REJECTED" />
  <bpmn:message id="Msg_Application" name="License application" />
  <bpmn:category id="P0_g1_cat"><bpmn:categoryValue id="P0_g1_cv" value="Art. 13 — finalising inspection within 1 month" /></bpmn:category>
  <bpmn:collaboration id="Collab_P0">
    <bpmn:participant id="Part_P0" name="Municipality" processRef="Process_00_overview" />
    <bpmn:participant id="Part_APP" name="Applicant (business owner)" />
    <bpmn:messageFlow id="P0_MF_0" name="Application" sourceRef="Part_APP" targetRef="P0_S0" />
    <bpmn:messageFlow id="P0_MF_1" name="Info e-mail, accrual invitation" sourceRef="P0_C1" targetRef="Part_APP" />
    <bpmn:messageFlow id="P0_MF_2" name="Cancellation notice" sourceRef="P0_C3" targetRef="Part_APP" />
    <bpmn:messageFlow id="P0_MF_3" name="Info e-mail, accrual invitation" sourceRef="P0_C4" targetRef="Part_APP" />
    <bpmn:messageFlow id="P0_MF_4" name="Fee payment" sourceRef="Part_APP" targetRef="P0_C4" />
    <bpmn:messageFlow id="P0_MF_5" name="Cancellation e-mail" sourceRef="P0_C5" targetRef="Part_APP" />
    <bpmn:messageFlow id="P0_MF_6" name="License approval notice" sourceRef="P0_C6" targetRef="Part_APP" />
    <bpmn:messageFlow id="P0_MF_7" name="Closure notice" sourceRef="P0_C7" targetRef="Part_APP" />
  </bpmn:collaboration>
  <bpmn:process id="Process_00_overview" name="Sanitary Establishment License — Overview" isExecutable="false">
    <bpmn:startEvent id="P0_S0" name="License application submitted">
      <bpmn:outgoing>P0_Flow_0</bpmn:outgoing>
      <bpmn:messageEventDefinition id="P0_S0_md" messageRef="Msg_Application" />
    </bpmn:startEvent>
    <bpmn:callActivity id="P0_C1" name="1 Register application and survey site" calledElement="Process_01_register_and_survey">
      <bpmn:incoming>P0_Flow_0</bpmn:incoming>
      <bpmn:outgoing>P0_Flow_1</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="P0_C2" name="2 Collect technical opinions" calledElement="Process_02_technical_opinions">
      <bpmn:incoming>P0_Flow_1</bpmn:incoming>
      <bpmn:outgoing>P0_Flow_2</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="P0_C3" name="3 Inspect premises" calledElement="Process_03_site_inspection">
      <bpmn:incoming>P0_Flow_2</bpmn:incoming>
      <bpmn:outgoing>P0_Flow_3</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="P0_C4" name="4 Commission review and fee collection" calledElement="Process_04_commission_and_fee">
      <bpmn:incoming>P0_Flow_3</bpmn:incoming>
      <bpmn:outgoing>P0_Flow_4</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="P0_C5" name="5 Executive approval" calledElement="Process_05_executive_approval">
      <bpmn:incoming>P0_Flow_4</bpmn:incoming>
      <bpmn:outgoing>P0_Flow_5</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="P0_C6" name="6 License and inform applicant" calledElement="Process_06_licensing">
      <bpmn:incoming>P0_Flow_5</bpmn:incoming>
      <bpmn:outgoing>P0_Flow_6</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="P0_E0" name="License issued">
      <bpmn:incoming>P0_Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="P0_B3a" name="Zoning rejected" attachedToRef="P0_C3">
      <bpmn:outgoing>P0_Flow_7</bpmn:outgoing>
      <bpmn:errorEventDefinition id="P0_B3a_ed" errorRef="Err_Zoning" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="P0_B3b" name="Failed second inspection" attachedToRef="P0_C3">
      <bpmn:outgoing>P0_Flow_8</bpmn:outgoing>
      <bpmn:errorEventDefinition id="P0_B3b_ed" errorRef="Err_Second" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="P0_B4" name="Rejected by commission" attachedToRef="P0_C4">
      <bpmn:outgoing>P0_Flow_9</bpmn:outgoing>
      <bpmn:errorEventDefinition id="P0_B4_ed" errorRef="Err_Commission" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="P0_B5a" name="Cancelled by deputy mayor level" attachedToRef="P0_C5">
      <bpmn:outgoing>P0_Flow_10</bpmn:outgoing>
      <bpmn:errorEventDefinition id="P0_B5a_ed" errorRef="Err_Deputy" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="P0_B5b" name="Cancelled at mayor level" attachedToRef="P0_C5">
      <bpmn:outgoing>P0_Flow_11</bpmn:outgoing>
      <bpmn:errorEventDefinition id="P0_B5b_ed" errorRef="Err_Mayor" />
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="P0_GC">
      <bpmn:incoming>P0_Flow_7</bpmn:incoming>
      <bpmn:incoming>P0_Flow_8</bpmn:incoming>
      <bpmn:incoming>P0_Flow_9</bpmn:incoming>
      <bpmn:incoming>P0_Flow_10</bpmn:incoming>
      <bpmn:incoming>P0_Flow_11</bpmn:incoming>
      <bpmn:outgoing>P0_Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="P0_C7" name="C Cancel license and close premises" calledElement="Process_07_cancellation_and_closure">
      <bpmn:incoming>P0_Flow_12</bpmn:incoming>
      <bpmn:outgoing>P0_Flow_13</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="P0_EC" name="Premises closed">
      <bpmn:incoming>P0_Flow_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P0_Flow_0" sourceRef="P0_S0" targetRef="P0_C1" />
    <bpmn:sequenceFlow id="P0_Flow_1" sourceRef="P0_C1" targetRef="P0_C2" />
    <bpmn:sequenceFlow id="P0_Flow_2" sourceRef="P0_C2" targetRef="P0_C3" />
    <bpmn:sequenceFlow id="P0_Flow_3" sourceRef="P0_C3" targetRef="P0_C4" />
    <bpmn:sequenceFlow id="P0_Flow_4" sourceRef="P0_C4" targetRef="P0_C5" />
    <bpmn:sequenceFlow id="P0_Flow_5" sourceRef="P0_C5" targetRef="P0_C6" />
    <bpmn:sequenceFlow id="P0_Flow_6" sourceRef="P0_C6" targetRef="P0_E0" />
    <bpmn:sequenceFlow id="P0_Flow_7" name="Zoning rejected" sourceRef="P0_B3a" targetRef="P0_GC" />
    <bpmn:sequenceFlow id="P0_Flow_8" name="Failed 2nd inspection" sourceRef="P0_B3b" targetRef="P0_GC" />
    <bpmn:sequenceFlow id="P0_Flow_9" name="Commission rejected" sourceRef="P0_B4" targetRef="P0_GC" />
    <bpmn:sequenceFlow id="P0_Flow_10" name="Deputy mayor level" sourceRef="P0_B5a" targetRef="P0_GC" />
    <bpmn:sequenceFlow id="P0_Flow_11" name="Mayor level" sourceRef="P0_B5b" targetRef="P0_GC" />
    <bpmn:sequenceFlow id="P0_Flow_12" sourceRef="P0_GC" targetRef="P0_C7" />
    <bpmn:sequenceFlow id="P0_Flow_13" sourceRef="P0_C7" targetRef="P0_EC" />
    <bpmn:textAnnotation id="P0_a1"><bpmn:text>Business is usually already operating when it applies (as-is practice). Art. 6: premises opened without a license are closed.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="P0_a1_assoc" sourceRef="P0_a1" targetRef="P0_S0" />
    <bpmn:group id="P0_g1" categoryValueRef="P0_g1_cv" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_P0" name="Sanitary Establishment License — Overview">
    <bpmndi:BPMNPlane id="Plane_P0" bpmnElement="Collab_P0">
      <bpmndi:BPMNShape id="Part_P0_di" bpmnElement="Part_P0" isHorizontal="true"><dc:Bounds x="10" y="160" width="1739" height="260" /></bpmndi:BPMNShape>
