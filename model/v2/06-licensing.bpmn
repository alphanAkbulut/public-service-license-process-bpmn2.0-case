<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Defs_P6" targetNamespace="https://github.com/alphanAkbulut/public-service-license-process-bpmn2.0-case" exporter="tools/v2/build.py" exporterVersion="2.0">
  <bpmn:collaboration id="Collab_P6">
    <bpmn:participant id="Part_P6" name="Municipality" processRef="Process_06_licensing" />
  </bpmn:collaboration>
  <bpmn:process id="Process_06_licensing" name="Stage 6 — License and inform applicant" isExecutable="false">
    <bpmn:laneSet id="LaneSet_P6">
      <bpmn:lane id="P6_Lane_RAP" name="Rapporteur">
        <bpmn:flowNodeRef>P6_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P6_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P6_x</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P6_xm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P6_e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P6_Lane_SYS" name="Automated Notifications">
        <bpmn:flowNodeRef>P6_t2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P6_s" name="License approved">
      <bpmn:outgoing>P6_Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="P6_t1" name="License the business and inform the citizen">
      <bpmn:documentation>Source step O41: Ruhsatlandırma ve Vatandaşın Bilgilendirmesi</bpmn:documentation>
      <bpmn:incoming>P6_Flow_0</bpmn:incoming>
      <bpmn:outgoing>P6_Flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P6_x" name="E-mail address registered?">
      <bpmn:incoming>P6_Flow_1</bpmn:incoming>
      <bpmn:outgoing>P6_Flow_2</bpmn:outgoing>
      <bpmn:outgoing>P6_Flow_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="P6_t2" name="Send license approval notice">
      <bpmn:documentation>Source step O42: Ruhsat Onay Bilgilendirmesi</bpmn:documentation>
      <bpmn:incoming>P6_Flow_2</bpmn:incoming>
      <bpmn:outgoing>P6_Flow_4</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="P6_xm">
      <bpmn:incoming>P6_Flow_3</bpmn:incoming>
      <bpmn:incoming>P6_Flow_4</bpmn:incoming>
      <bpmn:outgoing>P6_Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P6_e" name="License issued">
      <bpmn:incoming>P6_Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P6_Flow_0" sourceRef="P6_s" targetRef="P6_t1" />
    <bpmn:sequenceFlow id="P6_Flow_1" sourceRef="P6_t1" targetRef="P6_x" />
    <bpmn:sequenceFlow id="P6_Flow_2" name="Yes (label added)" sourceRef="P6_x" targetRef="P6_t2" />
    <bpmn:sequenceFlow id="P6_Flow_3" name="No (label added)" sourceRef="P6_x" targetRef="P6_xm" />
    <bpmn:sequenceFlow id="P6_Flow_4" sourceRef="P6_t2" targetRef="P6_xm" />
    <bpmn:sequenceFlow id="P6_Flow_5" sourceRef="P6_xm" targetRef="P6_e" />
    <bpmn:textAnnotation id="P6_a1"><bpmn:text>Issues the finalised license: the declaration-based license becomes final after the inspection (Art. 13).</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="P6_a1_assoc" sourceRef="P6_a1" targetRef="P6_t1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_P6" name="Stage 6 — License and inform applicant">
    <bpmndi:BPMNPlane id="Plane_P6" bpmnElement="Collab_P6">
      <bpmndi:BPMNShape id="Part_P6_di" bpmnElement="Part_P6" isHorizontal="true"><dc:Bounds x="10" y="20" width="1144" height="260" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P6_Lane_RAP_di" bpmnElement="P6_Lane_RAP" isHorizontal="true"><dc:Bounds x="40" y="20" width="1114" height="130" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P6_Lane_SYS_di" bpmnElement="P6_Lane_SYS" isHorizontal="true"><dc:Bounds x="40" y="150" width="1114" height="130" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P6_s_di" bpmnElement="P6_s"><dc:Bounds x="161" y="67" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="129" y="108" width="100" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P6_t1_di" bpmnElement="P6_t1"><dc:Bounds x="284" y="45" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P6_x_di" bpmnElement="P6_x" isMarkerVisible="true"><dc:Bounds x="494" y="60" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="539" y="30" width="88" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P6_t2_di" bpmnElement="P6_t2"><dc:Bounds x="624" y="175" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P6_xm_di" bpmnElement="P6_xm" isMarkerVisible="true"><dc:Bounds x="834" y="60" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P6_e_di" bpmnElement="P6_e"><dc:Bounds x="1011" y="67" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="985" y="108" width="88" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P6_a1_di" bpmnElement="P6_a1"><dc:Bounds x="249" y="147" width="250" height="52" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="P6_Flow_0_di" bpmnElement="P6_Flow_0"><di:waypoint x="197" y="85" /><di:waypoint x="284" y="85" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P6_Flow_1_di" bpmnElement="P6_Flow_1"><di:waypoint x="414" y="85" /><di:waypoint x="494" y="85" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P6_Flow_2_di" bpmnElement="P6_Flow_2"><di:waypoint x="519" y="110" /><di:waypoint x="519" y="215" /><di:waypoint x="624" y="215" /><bpmndi:BPMNLabel><dc:Bounds x="525" y="127" width="94" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P6_Flow_3_di" bpmnElement="P6_Flow_3"><di:waypoint x="544" y="85" /><di:waypoint x="834" y="85" /><bpmndi:BPMNLabel><dc:Bounds x="550" y="67" width="88" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P6_Flow_4_di" bpmnElement="P6_Flow_4"><di:waypoint x="754" y="215" /><di:waypoint x="859" y="215" /><di:waypoint x="859" y="110" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P6_Flow_5_di" bpmnElement="P6_Flow_5"><di:waypoint x="884" y="85" /><di:waypoint x="1011" y="85" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P6_a1_assoc_di" bpmnElement="P6_a1_assoc"><di:waypoint x="374" y="147" /><di:waypoint x="365" y="125" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
