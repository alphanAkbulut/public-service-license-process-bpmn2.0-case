<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Defs_P2" targetNamespace="https://github.com/alphanAkbulut/public-service-license-process-bpmn2.0-case" exporter="tools/v2/build.py" exporterVersion="2.0">
  <bpmn:collaboration id="Collab_P2">
    <bpmn:participant id="Part_P2" name="Municipality" processRef="Process_02_technical_opinions" />
  </bpmn:collaboration>
  <bpmn:process id="Process_02_technical_opinions" name="Stage 2 — Collect technical opinions" isExecutable="false">
    <bpmn:laneSet id="LaneSet_P2">
      <bpmn:lane id="P2_Lane_LD" name="Licensing &amp; Inspection Directorate">
        <bpmn:flowNodeRef>P2_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_gS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_gF</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_tF</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_gFm</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P2_Lane_ZDIR" name="Zoning &amp; Urban Planning Director">
        <bpmn:flowNodeRef>P2_tZ</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_cZ</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_tG2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_gJ</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P2_Lane_GIS" name="City Information Service">
        <bpmn:flowNodeRef>P2_tG1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P2_Lane_DEP" name="Deputy Mayor">
        <bpmn:flowNodeRef>P2_tG3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P2_s" name="Office review completed">
      <bpmn:outgoing>P2_Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="P2_gS">
      <bpmn:incoming>P2_Flow_0</bpmn:incoming>
      <bpmn:outgoing>P2_Flow_1</bpmn:outgoing>
      <bpmn:outgoing>P2_Flow_2</bpmn:outgoing>
      <bpmn:outgoing>P2_Flow_3</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="P2_gF" name="Fire report needed?">
      <bpmn:incoming>P2_Flow_1</bpmn:incoming>
      <bpmn:outgoing>P2_Flow_4</bpmn:outgoing>
      <bpmn:outgoing>P2_Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P2_tF" name="Request fire department report">
      <bpmn:documentation>Source step O9: Sıhhi Müessese Ruhsat Başvurusu - İtfaiye Raporu Talebi</bpmn:documentation>
      <bpmn:incoming>P2_Flow_4</bpmn:incoming>
      <bpmn:outgoing>P2_Flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P2_gFm">
      <bpmn:incoming>P2_Flow_5</bpmn:incoming>
      <bpmn:incoming>P2_Flow_6</bpmn:incoming>
      <bpmn:outgoing>P2_Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P2_tZ" name="Query zoning status">
      <bpmn:documentation>Source step O13: Sıhhi Müessese Ruhsat Başvurusu - İmar Durumu Sorgulama</bpmn:documentation>
      <bpmn:incoming>P2_Flow_2</bpmn:incoming>
      <bpmn:outgoing>P2_Flow_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:callActivity id="P2_cZ" name="Prepare zoning opinions" calledElement="Process_02a_zoning_opinions">
      <bpmn:incoming>P2_Flow_8</bpmn:incoming>
      <bpmn:outgoing>P2_Flow_9</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:userTask id="P2_tG1" name="Determine current address">
      <bpmn:documentation>Source step O10: Kent Bilgi Servisi - Güncel Adres Tespiti</bpmn:documentation>
      <bpmn:incoming>P2_Flow_3</bpmn:incoming>
      <bpmn:outgoing>P2_Flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P2_tG2" name="Approve address determination">
      <bpmn:documentation>Source step O11: İmar Müdürü - Adres Tespiti Onay</bpmn:documentation>
      <bpmn:incoming>P2_Flow_10</bpmn:incoming>
      <bpmn:outgoing>P2_Flow_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P2_tG3" name="Approve address determination">
      <bpmn:documentation>Source step O12: Başkan Yardımcısı - Adres Tespiti Onay</bpmn:documentation>
      <bpmn:incoming>P2_Flow_11</bpmn:incoming>
      <bpmn:outgoing>P2_Flow_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="P2_gJ">
      <bpmn:incoming>P2_Flow_7</bpmn:incoming>
      <bpmn:incoming>P2_Flow_9</bpmn:incoming>
      <bpmn:incoming>P2_Flow_12</bpmn:incoming>
      <bpmn:outgoing>P2_Flow_13</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="P2_e" name="Technical opinions completed">
      <bpmn:incoming>P2_Flow_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P2_Flow_0" sourceRef="P2_s" targetRef="P2_gS" />
    <bpmn:sequenceFlow id="P2_Flow_1" sourceRef="P2_gS" targetRef="P2_gF" />
    <bpmn:sequenceFlow id="P2_Flow_2" sourceRef="P2_gS" targetRef="P2_tZ" />
    <bpmn:sequenceFlow id="P2_Flow_3" sourceRef="P2_gS" targetRef="P2_tG1" />
    <bpmn:sequenceFlow id="P2_Flow_4" name="Needed (label added)" sourceRef="P2_gF" targetRef="P2_tF" />
    <bpmn:sequenceFlow id="P2_Flow_5" name="Fire report not needed" sourceRef="P2_gF" targetRef="P2_gFm" />
    <bpmn:sequenceFlow id="P2_Flow_6" sourceRef="P2_tF" targetRef="P2_gFm" />
    <bpmn:sequenceFlow id="P2_Flow_7" sourceRef="P2_gFm" targetRef="P2_gJ" />
    <bpmn:sequenceFlow id="P2_Flow_8" sourceRef="P2_tZ" targetRef="P2_cZ" />
    <bpmn:sequenceFlow id="P2_Flow_9" sourceRef="P2_cZ" targetRef="P2_gJ" />
    <bpmn:sequenceFlow id="P2_Flow_10" sourceRef="P2_tG1" targetRef="P2_tG2" />
    <bpmn:sequenceFlow id="P2_Flow_11" sourceRef="P2_tG2" targetRef="P2_tG3" />
    <bpmn:sequenceFlow id="P2_Flow_12" sourceRef="P2_tG3" targetRef="P2_gJ" />
    <bpmn:sequenceFlow id="P2_Flow_13" sourceRef="P2_gJ" targetRef="P2_e" />
    <bpmn:textAnnotation id="P2_a2"><bpmn:text>Opens Stage 2a: building inspection and mapping branches plus the deputy mayor approval, unchanged</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="P2_a2_assoc" sourceRef="P2_a2" targetRef="P2_cZ" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_P2" name="Stage 2 — Collect technical opinions">
    <bpmndi:BPMNPlane id="Plane_P2" bpmnElement="Collab_P2">
      <bpmndi:BPMNShape id="Part_P2_di" bpmnElement="Part_P2" isHorizontal="true"><dc:Bounds x="10" y="20" width="1484" height="780" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_Lane_LD_di" bpmnElement="P2_Lane_LD" isHorizontal="true"><dc:Bounds x="40" y="20" width="1454" height="260" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_Lane_ZDIR_di" bpmnElement="P2_Lane_ZDIR" isHorizontal="true"><dc:Bounds x="40" y="280" width="1454" height="260" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_Lane_GIS_di" bpmnElement="P2_Lane_GIS" isHorizontal="true"><dc:Bounds x="40" y="540" width="1454" height="130" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_Lane_DEP_di" bpmnElement="P2_Lane_DEP" isHorizontal="true"><dc:Bounds x="40" y="670" width="1454" height="130" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_s_di" bpmnElement="P2_s"><dc:Bounds x="161" y="197" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="138" y="238" width="82" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_gS_di" bpmnElement="P2_gS"><dc:Bounds x="324" y="190" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_gF_di" bpmnElement="P2_gF" isMarkerVisible="true"><dc:Bounds x="494" y="190" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="539" y="242" width="118" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_tF_di" bpmnElement="P2_tF"><dc:Bounds x="624" y="45" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_gFm_di" bpmnElement="P2_gFm" isMarkerVisible="true"><dc:Bounds x="834" y="190" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_tZ_di" bpmnElement="P2_tZ"><dc:Bounds x="454" y="305" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_cZ_di" bpmnElement="P2_cZ"><dc:Bounds x="624" y="305" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_tG1_di" bpmnElement="P2_tG1"><dc:Bounds x="454" y="565" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_tG2_di" bpmnElement="P2_tG2"><dc:Bounds x="624" y="435" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_tG3_di" bpmnElement="P2_tG3"><dc:Bounds x="794" y="695" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_gJ_di" bpmnElement="P2_gJ"><dc:Bounds x="1174" y="320" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_e_di" bpmnElement="P2_e"><dc:Bounds x="1351" y="327" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1313" y="368" width="112" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_a2_di" bpmnElement="P2_a2"><dc:Bounds x="779" y="245" width="240" height="52" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="P2_Flow_0_di" bpmnElement="P2_Flow_0"><di:waypoint x="197" y="215" /><di:waypoint x="324" y="215" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_Flow_1_di" bpmnElement="P2_Flow_1"><di:waypoint x="374" y="215" /><di:waypoint x="494" y="215" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_Flow_2_di" bpmnElement="P2_Flow_2"><di:waypoint x="349" y="240" /><di:waypoint x="349" y="345" /><di:waypoint x="454" y="345" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_Flow_3_di" bpmnElement="P2_Flow_3"><di:waypoint x="349" y="240" /><di:waypoint x="349" y="605" /><di:waypoint x="454" y="605" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_Flow_4_di" bpmnElement="P2_Flow_4"><di:waypoint x="519" y="190" /><di:waypoint x="519" y="85" /><di:waypoint x="624" y="85" /><bpmndi:BPMNLabel><dc:Bounds x="525" y="159" width="110" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_Flow_5_di" bpmnElement="P2_Flow_5"><di:waypoint x="544" y="215" /><di:waypoint x="834" y="215" /><bpmndi:BPMNLabel><dc:Bounds x="550" y="197" width="121" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_Flow_6_di" bpmnElement="P2_Flow_6"><di:waypoint x="754" y="85" /><di:waypoint x="859" y="85" /><di:waypoint x="859" y="190" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_Flow_7_di" bpmnElement="P2_Flow_7"><di:waypoint x="884" y="215" /><di:waypoint x="1199" y="215" /><di:waypoint x="1199" y="320" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_Flow_8_di" bpmnElement="P2_Flow_8"><di:waypoint x="584" y="345" /><di:waypoint x="624" y="345" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_Flow_9_di" bpmnElement="P2_Flow_9"><di:waypoint x="754" y="345" /><di:waypoint x="1174" y="345" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_Flow_10_di" bpmnElement="P2_Flow_10"><di:waypoint x="584" y="605" /><di:waypoint x="604" y="605" /><di:waypoint x="604" y="475" /><di:waypoint x="624" y="475" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_Flow_11_di" bpmnElement="P2_Flow_11"><di:waypoint x="754" y="475" /><di:waypoint x="774" y="475" /><di:waypoint x="774" y="735" /><di:waypoint x="794" y="735" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_Flow_12_di" bpmnElement="P2_Flow_12"><di:waypoint x="924" y="735" /><di:waypoint x="1199" y="735" /><di:waypoint x="1199" y="370" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_Flow_13_di" bpmnElement="P2_Flow_13"><di:waypoint x="1224" y="345" /><di:waypoint x="1351" y="345" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_a2_assoc_di" bpmnElement="P2_a2_assoc"><di:waypoint x="779" y="271" /><di:waypoint x="738" y="305" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
